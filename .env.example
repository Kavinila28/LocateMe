# LocateMe Environment Configuration (Phase 1)

# Experimental cosine similarity threshold (default: 0.68)
# Range: [-1.0, 1.0]. Typical benchmark for InceptionResnetV1 VGGFace2 is 0.60 - 0.75
SIMILARITY_THRESHOLD=0.68

# Device configuration: 'cpu' or 'cuda' (auto-detected if blank)
DEVICE=cpu

# Model pretrained weights (default: 'vggface2', alternative: 'casia-webface')
MODEL_WEIGHTS=vggface2

# Minimum MTCNN face detection probability to accept
MIN_FACE_PROBABILITY=0.85
