# LocateMe — Environment Configuration Template
# Copy this file to .env and configure your variables

# Optional Supabase Configuration (Phase 4: Cloud Persistence & pgvector)
# Leave blank to run in 100% offline Local Mode (data/registered/ + data/gallery_cache.npz)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_BUCKET=missing-persons-photos

# Optional Service Settings
SIMILARITY_THRESHOLD=0.68
DEFAULT_FRAME_STEP=5
PORT=8000
HOST=127.0.0.1
